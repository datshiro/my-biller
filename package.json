{
  "name": "my-biller",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:recovery": "tsc -b && vite build --mode recovery",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "preview:recovery": "vite preview --outDir dist-recovery --host 127.0.0.1 --port 5176 --strictPort",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:recovery": "npm run build && npm run build:staging -- --outDir dist-next && npm run build:recovery && npm run test:e2e:recovery:built",
    "test:e2e:recovery:built": "playwright test --config playwright.recovery.config.ts",
    "test:live": "./robot/run.sh",
    "test:live:recovery": "npm run build:recovery && ROBOT_APP_MODE=recovery ./robot/run.sh robot/recovery",
    "test:staging": "ROBOT_REMOTE=1 ./robot/run.sh",
    "test:regression": "./robot/run.sh -i regression robot/tests",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy:staging": "wrangler deploy --config worker/wrangler.toml --env staging",
    "worker:smoke:bootstrap": "node worker/scripts/smoke-bootstrap.mjs",
    "worker:smoke:state": "node worker/scripts/check-production-smoke-state.mjs",
    "worker:smoke:production": "node worker/scripts/smoke-production.mjs",
    "pages:smoke": "node scripts/verify-pages-deployment.mjs"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
